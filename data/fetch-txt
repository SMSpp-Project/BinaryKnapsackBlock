#!/usr/bin/env bash
#
# usage: fetch-txt [ <local archive.tgz> ]
#
# Populate ../data/txt with the curated Pisinger knapsack instance classes,
# one text file per instance in the BinaryKnapsackBlock 'P' load format:
#   n                          (number of items)
#   <index> <profit> <weight>  (one line per item, n lines)
#   C                          (capacity, last line)
#
# The source is David Pisinger's small-coefficient benchmark
# (smallcoeff_pisinger.tgz, see https://hjemmesider.diku.dk/~pisinger/codes.html),
# whose .csv files pack 100 instances each with header lines (n/c/z/time) and
# CSV item rows "index,profit,weight,xstar"; we strip those down to the bare
# 'P' format read by BinaryKnapsackBlock::load( istream , 'P' ).
#
# Pass a path to an already-downloaded smallcoeff_pisinger.tgz to skip the
# (large) download. After running, regenerate the .nc4 with tools/batch, then
# ./compress and ./upload-txt to publish txt.tgz to the Package Registry.

set -euo pipefail

cd "$(dirname "$0")"   # run from data/

URL="https://hjemmesider.diku.dk/~pisinger/smallcoeff_pisinger.tgz"

# curated subset (Pisinger naming knapPI_<type>_<n>_<R>):
#   type 1 = uncorrelated, type 6 = subset-sum; n in {50,100,200,500}, R = 1000.
# The spread of sizes covers the solvers' small-tree base cases up to the regime
# where they clearly diverge, while the full 9-solver cross-check still finishes
# in a couple of minutes; larger n only explode the exact BranchAndXSolver modes
# on the uncorrelated class, without adding correctness coverage.
CLASSES=(
  "knapPI_1_50_1000"  "knapPI_6_50_1000"
  "knapPI_1_100_1000" "knapPI_6_100_1000"
  "knapPI_1_200_1000" "knapPI_6_200_1000"
  "knapPI_1_500_1000" "knapPI_6_500_1000"
)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

arch=${1:-}
if [ -z "$arch" ]; then
  arch="$tmp/smallcoeff_pisinger.tgz"
  echo "Downloading $URL ..."
  curl -fsSL -o "$arch" "$URL"
fi

rm -rf txt
for cls in "${CLASSES[@]}"; do
  tar xzf "$arch" -C "$tmp" "$cls.csv"
  mkdir -p "txt/$cls"
  awk -v dir="txt/$cls" '
    { sub(/\r$/, "") }                        # tolerate CRLF
    /^knapPI_/ { name = $0; next }            # instance name
    /^n /      { n = $2; next }               # number of items
    /^c /      { c = $2; next }               # capacity (emitted last)
    /^z /      { next }                       # optimum: kept in the raw .csv
    /^time/    { out = dir "/" name ".txt"; print n > out; next }
    /^-----/   { print c >> out; close( out ); next }  # end of instance
    /,/        { split( $0 , a , "," ); print a[1], a[2], a[3] >> out }
  ' "$tmp/$cls.csv"
  # keep the raw .csv (it carries the published optimum z and x*) next to the
  # stripped instances, for the solver-vs-reference cross-check that reads it
  # in a single process (see tests/BinaryKnapsackBlock/batches/batch-pisinger,
  # which feeds the .csv to the test via -C)
  cp "$tmp/$cls.csv" "txt/$cls.csv"
  echo "  $cls: $(ls "txt/$cls"/*.txt | wc -l) instances"
done

