#!/usr/bin/env bash
#
# usage: fetch-jooken [ <n_instances> ]
#
# Populate ../data/jooken with a curated subset of the Jooken-Leyman-De
# Causmaecker hard 0-1 knapsack instances, converted to the same .csv format
# read by the test in Pisinger mode (-C), so the solver-vs-reference and
# solver-vs-solver cross-check works unchanged.
#
# The source is the public dataset https://github.com/JorikJooken/
# knapsackProblemInstances : every instance lives in a subfolder of
# problemInstances/ whose name encodes the generator parameters
# (n_<items>_c_<capacity>_g_<...>_f_<...>_eps_<...>_s_<seed>) and holds a
# test.in file "n / <id> <profit> <weight> x n / c"; the optimal values are
# collected in optima.csv ("name,optimum", optimum = -1 when combo did not
# solve it). These instances are designed to defeat branch-and-bound, so we
# curate the smaller-capacity (1e6), known-optimum ones, which still explode
# the tree while staying tractable for the from-scratch greedy relaxation.
#
# Each instance becomes ../data/jooken/<name>.csv carrying a single block in
# the knapPI layout (the parser keys on the leading "knapPI" token):
#   knapPI_jooken_<name>
#   n <n> / c <c> / z <optimum> / time 0
#   <id>,<profit>,<weight>,0   (one line per item)
#   -----

set -euo pipefail

cd "$(dirname "$0")"   # run from data/

RAW="https://raw.githubusercontent.com/JorikJooken/knapsackProblemInstances/master"
CAP=${1:-1000000}      # capacity bucket to curate (1e6 / 1e8 / 1e10 ...)
N=${2:-8}              # how many instances to curate

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

echo "Downloading optima.csv ..."
curl -fsSL -o "$tmp/optima.csv" "$RAW/optima.csv"

# curate: known optimum (> 0, i.e. not even combo gave up), the requested
# capacity bucket, n in {800,1000} -> a spread of the generator's g/f/eps knobs
mapfile -t names < <(
  grep -E "^n_(800|1000)_c_${CAP}_" "$tmp/optima.csv" \
  | awk -F, '$2 > 0 { print $1 }' | head -n "$N" )

if [ "${#names[@]}" -eq 0 ]; then
  echo "no curated Jooken instance matched capacity $CAP" >&2
  exit 1
fi

# additive: keep instances from other capacity buckets already fetched
mkdir -p jooken
for name in "${names[@]}"; do
  opt=$( awk -F, -v k="$name" '$1 == k { print $2 }' "$tmp/optima.csv" )
  curl -fsSL -o "$tmp/test.in" "$RAW/problemInstances/$name/test.in"
  out="jooken/$name.csv"
  awk -v name="knapPI_jooken_$name" -v z="$opt" '
    NR == 1   { n = $1; next }                # first line: number of items
    NF >= 3   { id[ NR ] = $1; p[ NR ] = $2; w[ NR ] = $3; next }  # item rows
    NF == 1   { cap = $1 }                     # capacity line (last single int)
    END {
      print name
      print "n " n
      print "c " cap
      print "z " z
      print "time 0"
      for( i = 2 ; i <= n + 1 ; i++ )
        print id[ i ] "," p[ i ] "," w[ i ] ",0"
      print "-----"
    }' "$tmp/test.in" > "$out"
  echo "  $name : n=$(sed -n '2p' "$out" | cut -d' ' -f2)  z=$opt"
done

echo "wrote ${#names[@]} instances to data/jooken/"
