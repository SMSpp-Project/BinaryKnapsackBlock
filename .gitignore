# ============================================================
#  BinaryKnapsackBlock — .gitignore
# ============================================================

# --- C/C++ build artifacts ----------------------------------
*.o
*.obj
*.d
*.gch
*.pch
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/
*.pdb
*.idb
*.ilk
*.map
*.exp
*.gcno
*.gcda

# --- Generated netCDF instances and txt sources -------------
*.nc4
data/txt
data/txt.tgz
data/.extracted
data/nc4/.generated

# --- Benchmark payload (fetched by data/fetch-benchmarks) ----
data/benchmarks/

# --- Tool binaries ------------------------------------------
tools/bk2nc4
tools/bkbench

# --- CMake --------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeLists.txt.user
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# --- IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
out/

# --- OS junk ------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*~
.directory
.fuse_hidden*
.nfs*
