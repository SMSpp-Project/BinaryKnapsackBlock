#!/usr/bin/env bash
#
# usage: batch < bk2nc4 exe >
#        < bk2nc4 exe > = path of the converter, default ./bk2nc4
#
# Converts every text instance under ../data/txt into a BinaryKnapsackBlock
# netCDF (.nc4) under ../data/nc4, mirroring the directory layout. The
# Pisinger/Jooken knapsack benchmark format is read with frmt 'P' [see
# BinaryKnapsackBlock::load( std::istream & , char )].

bk2nc4=${1:-./bk2nc4}

cd "$(dirname "$0")"   # run from tools/

shopt -s globstar nullglob

for txt in ../data/txt/**/*.txt; do
  rel=${txt#../data/txt/}        # path relative to data/txt
  out=../data/nc4/${rel%.txt}.nc4
  mkdir -p "$(dirname "$out")"
  "$bk2nc4" "$txt" P "$out"
done

